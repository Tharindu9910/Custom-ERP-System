{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "globalSetup": "<rootDir>/global-setup.js",
  "testTimeout": 60000,
  "maxWorkers": 1,
  "setupFiles": [
    "<rootDir>/setup-env.js"
  ],
  "forceExit": true
}
