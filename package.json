  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter api migration:run",
    "db:seed": "pnpm --filter api seed && pnpm --filter api seed:demo",
