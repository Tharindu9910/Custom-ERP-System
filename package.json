    "test:e2e:api": "pnpm --filter api test:e2e",
    "test:e2e:web": "pnpm --filter @erp/e2e test",
    "test:e2e": "pnpm test:e2e:api && pnpm test:e2e:web"
  },
  "devDependencies": {
    "turbo": "latest"
  },
